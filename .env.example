# =============================================================================
# Happy-Heads Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# =============================================================================
# Node Environment
# =============================================================================
# Options: development, production, test
NODE_ENV=development

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# IMPORTANT: Change these values in production!
POSTGRES_USER=happyheads
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=happyheads_db
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_PORT=8000

# Backend URL (used for generating absolute URLs like avatar paths)
# In production, this should be your actual domain
BACKEND_URL=http://localhost:8000

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=3000

# Frontend URL (used for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Vite build-time environment variables
# These are baked into the frontend build
VITE_BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# Security Configuration
# =============================================================================
# IMPORTANT: Generate secure random strings for production!
# You can use: openssl rand -base64 32

# JWT Secret for token signing (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# JWT Token expiration (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Session secret for express-session
SESSION_SECRET=your-session-secret-also-minimum-32-characters

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# Google OAuth Configuration (Optional)
# =============================================================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# =============================================================================
# Development Tools (Only used with docker-compose.dev.yml)
# =============================================================================
# pgAdmin credentials
PGADMIN_EMAIL=admin@happyheads.local
PGADMIN_PASSWORD=admin

# =============================================================================
# Production-Specific (Only for docker-compose.prod.yml)
# =============================================================================
# SSL Certificate paths (if using HTTPS directly in nginx)
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
