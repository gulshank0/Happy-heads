# Happy Heads Frontend Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
#
# IMPORTANT FOR DEPLOYMENT:
# - For Vercel: Set these in your Vercel project settings > Environment Variables
# - These variables are REQUIRED in production

# ===================
# DEVELOPMENT SETTINGS
# ===================
# For local development, you can use localhost URLs
# VITE_BACKEND_URL=https://backend-happy-heads.onrender.com
# VITE_WS_URL=wss://backend-happy-heads.onrender.com

# ===================
# PRODUCTION SETTINGS (Vercel + AWS)
# ===================
# Set these to your AWS backend URLs in Vercel environment variables
# Example:
# VITE_BACKEND_URL=https://api.your-domain.com
# VITE_WS_URL=wss://api.your-domain.com

# Backend API URL (REQUIRED)
# The base URL of your backend API running on AWS
VITE_BACKEND_URL=

# WebSocket URL (REQUIRED)
# The WebSocket URL for real-time messaging (typically same host as backend, with ws:// or wss://)
VITE_WS_URL=

# ===================
# OPTIONAL SETTINGS
# ===================
PING_MESSAGE="ping pong"