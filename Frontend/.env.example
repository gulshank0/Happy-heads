# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
PING_MESSAGE="ping pong"


# Frontend URL (must have VITE_ prefix for Vite to expose to frontend)
VITE_FRONTEND_URL=http://localhost:3000

# Backend URL (must have VITE_ prefix for Vite to expose to frontend)
VITE_BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Updated Google client credentials for security
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
GOOGLE_CALLBACK_URL=