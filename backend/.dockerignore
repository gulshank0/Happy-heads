# =============================================================================
# Backend .dockerignore
# =============================================================================
# Files and directories to exclude from Docker build context
# This reduces build time and prevents sensitive data from being included
# =============================================================================

# Dependencies - will be installed fresh in container
node_modules

# Build output - will be generated in container
dist

# Generated Prisma client - will be regenerated
generated

# Environment files - should use Docker secrets or env vars
.env
.env.*
*.local

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editor files
.vscode
.idea
*.swp
*.swo
.DS_Store

# Git files
.git
.gitignore

# Test files
*.spec.ts
*.test.ts
__tests__
coverage

# Documentation
README.md
CHANGELOG.md
docs

# Docker files (not needed inside container)
Dockerfile
docker-compose*.yml
.dockerignore

# Uploads (should be mounted as volume)
uploads/*
!uploads/.gitkeep

# TypeScript source maps in production
*.map

# Temporary files
tmp
temp
*.tmp
