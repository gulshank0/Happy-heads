# Happy Heads Backend Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
#
# IMPORTANT FOR DEPLOYMENT (Render/AWS/Railway):
# - Set these environment variables in your deployment configuration
# - All URLs must be absolute (no localhost in production)

# ===================
# SERVER SETTINGS
# ===================
PORT=8000
NODE_ENV=development

# ===================
# URLs (REQUIRED FOR PRODUCTION)
# ===================
# Your Vercel frontend URL (for CORS)
# Example: https://your-app.vercel.app
FRONTEND_URL=

# Your Render backend URL (for generating absolute URLs)
# Example: https://happy-heads-backend.onrender.com
BACKEND_URL=

# Additional CORS origins (optional, comma-separated)
# CORS_ORIGIN=https://other-allowed-domain.com

# ===================
# DATABASE (REQUIRED)
# ===================
# Render provides this automatically when you link a PostgreSQL database
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# ===================
# AUTHENTICATION (REQUIRED)
# ===================
# Generate a secure random string for session secret
# Render can auto-generate this - use generateValue: true in render.yaml
# Or generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===================
# GOOGLE OAUTH (REQUIRED FOR SOCIAL LOGIN)
# ===================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this to your Render backend URL + callback path
# Example: https://happy-heads-backend.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=
