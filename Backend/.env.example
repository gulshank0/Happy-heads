# Happy Heads Backend Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
#
# IMPORTANT FOR DEPLOYMENT (AWS):
# - Set these environment variables in your AWS deployment configuration
# - All URLs must be absolute (no localhost in production)

# ===================
# SERVER SETTINGS
# ===================
PORT=8000
NODE_ENV=development

# ===================
# URLs (REQUIRED FOR PRODUCTION)
# ===================
# Your Vercel frontend URL (for CORS)
# Example: https://your-app.vercel.app
FRONTEND_URL=

# Your AWS backend URL (for generating absolute URLs)
# Example: https://api.your-domain.com
BACKEND_URL=

# Additional CORS origins (optional, comma-separated)
# CORS_ORIGIN=https://other-allowed-domain.com

# ===================
# DATABASE (REQUIRED)
# ===================
DATABASE_URL=

# ===================
# AUTHENTICATION (REQUIRED)
# ===================
# Generate a secure random string for session secret
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===================
# GOOGLE OAUTH (REQUIRED FOR SOCIAL LOGIN)
# ===================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this to your AWS backend URL + callback path
# Example: https://api.your-domain.com/auth/google/callback
GOOGLE_CALLBACK_URL=
